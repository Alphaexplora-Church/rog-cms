{
    "kind": "collectionType",
    "collectionName": "scriptures",
    "info": {
        "singularName": "scripture",
        "pluralName": "scriptures",
        "displayName": "Scripture",
        "description": "A Bible book/passage reference for filtering sermons (e.g. 'Jonah', 'Ecclesiastes'). Add once, then select."
    },
    "options": {
        "draftAndPublish": false
    },
    "pluginOptions": {},
    "attributes": {
        "title": {
            "type": "string",
            "required": true
        },
        "slug": {
            "type": "uid",
            "targetField": "title",
            "required": true
        },
        "sermons": {
            "type": "relation",
            "relation": "oneToMany",
            "target": "api::sermon.sermon",
            "mappedBy": "scripture"
        }
    }
}
